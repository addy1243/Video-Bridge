{
  "manifest_version": 3,
  "name": "VideoBridge",
  "version": "0.4.0",
  "description": "Find video streams on webpages and download supported public media using a local helper.",
  "minimum_chrome_version": "105",
  "permissions": ["activeTab", "nativeMessaging", "storage", "alarms", "scripting", "webRequest"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "optional_permissions": ["cookies"],
  "action": { "default_popup": "popup.html", "default_title": "Download with VideoBridge" },
  "background": { "service_worker": "background.js", "type": "module" }
}
